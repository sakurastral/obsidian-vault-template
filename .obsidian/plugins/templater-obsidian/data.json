{
  "data_version": 2,
  "command_timeout": 5,
  "templates_folder": "Assets/Template",
  "templates_pairs": [],
  "trigger_on_file_creation_mode": "folder",
  "auto_jump_to_cursor": true,
  "jump_to_cursor_after_file_name": false,
  "shell_path": "",
  "user_scripts_folder": "Assets/Scripts",
  "folder_templates": [
    {
      "folder": "Inbox",
      "template": "Assets/Template/Inbox/Add New Note.md"
    },
    {
      "folder": "Project",
      "template": "Assets/Template/Project/Add New Note.md"
    },
    {
      "folder": "Knowledge",
      "template": "Assets/Template/Inbox/Add New Note.md"
    },
    {
      "folder": "Task/Inbox",
      "template": "Assets/Template/Task/Add New Task.md"
    },
    {
      "folder": "Nexus/Categories",
      "template": "Assets/Template/Nexus/Add New Category.md"
    },
    {
      "folder": "Calendar",
      "template": "Assets/Template/Calendar/Add New Event.md"
    },
    {
      "folder": "Journal",
      "template": "Assets/Template/Journal/Add Daily Note.md"
    }
  ],
  "file_templates": [],
  "syntax_highlighting": true,
  "syntax_highlighting_mobile": false,
  "enabled_templates_hotkeys": [
    "Assets/Template/Task/Add New Task.md",
    "Assets/Template/Task/Mark as Completed.md",
    "Assets/Template/Task/Mark as Cancelled.md",
    "Assets/Template/Task/Mark as In Progess.md",
    "Assets/Template/Task/Archive Task.md",
    "Assets/Template/Properties/Change Note Name.md",
    "Assets/Template/Custom/Convert Color Codes to HTML Block.md",
    "Assets/Template/Project/Calendar/Add New Event.md",
    "Assets/Template/Project/Journal/Add Daily Note.md",
    "Assets/Template/Custom/Insert Bases Block to View Child Notes.md"
  ],
  "startup_templates": [],
  "intellisense_render": "1",
  "ignore_folders_on_creation": [],
  "enable_ribbon_icon": true
}