{
  "rules": [
    {
      "name": "Header",
      "enabled": true,
      "type": "multi",
      "negated": false,
      "contentSource": "file",
      "footerText": "",
      "renderLocation": "header",
      "renderAboveProperties": false,
      "footerFilePath": "Assets/Template/Layout/Header.md",
      "showInPopover": false,
      "showInEmbed": false,
      "showInCanvas": false,
      "conditions": [
        {
          "type": "folder",
          "negated": false,
          "path": "Collection/",
          "recursive": true
        },
        {
          "type": "folder",
          "negated": false,
          "path": "Project/",
          "recursive": true
        },
        {
          "type": "folder",
          "negated": false,
          "path": "Inbox/",
          "recursive": true
        },
        {
          "type": "folder",
          "path": "Nexus/",
          "recursive": true,
          "negated": false
        }
      ],
      "multiConditionLogic": "any"
    },
    {
      "name": "Footer",
      "enabled": true,
      "type": "multi",
      "negated": false,
      "contentSource": "file",
      "footerText": "",
      "renderLocation": "footer",
      "renderAboveBacklinks": true,
      "footerFilePath": "Assets/Template/Layout/Footer.md",
      "showInPopover": false,
      "showInEmbed": false,
      "showInCanvas": false,
      "conditions": [
        {
          "type": "folder",
          "negated": false,
          "path": "Collection/",
          "recursive": true
        },
        {
          "type": "folder",
          "negated": false,
          "path": "Project/",
          "recursive": true
        },
        {
          "type": "folder",
          "negated": false,
          "path": "Inbox/",
          "recursive": true
        }
      ],
      "multiConditionLogic": "any"
    }
  ],
  "refreshOnFileOpen": true,
  "renderInSourceMode": false,
  "refreshOnMetadataChange": false,
  "smartPropertyLinks": false,
  "enableEmbedRendering": false,
  "enableCanvasRendering": false,
  "debugEmbedCanvas": false
