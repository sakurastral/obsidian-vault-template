filters:
  and:
    - file.path == this.file.path
    - file.folder == this.file.folder
formulas:
  schedule: if(note["Task：Scheduled(Start)"] && note["Task：Scheduled(Start)"]!="",note["Task：Scheduled(Start)"].format("YYYY-MM-DD HH:mm"),"")+if(note["Task：Scheduled(End)"] && (note["Task：Scheduled(Start)"].toString() != note["Task：Scheduled(End)"].toString()), " ~ "+note["Task：Scheduled(End)"].format("YYYY-MM-DD HH:mm"), "-")
  due: Task：Due.format("YYYY-MM-DD HH:mm")
  finish-state: |-
    if(Task：Done, "任務已於"+Task：Done.format("YYYY年MM月DD日")+"完成", "")+
    if(Task：Cancelled, "任務已於"+Task：Cancelled.format("YYYY年MM月DD日")+"取消","")+if(Task：Archived, "並已歸檔", "-")
properties:
  note.Task：Content:
    displayName: 任務內容
  note.Task：Status:
    displayName: 執行進度
  note.Task：Priority:
    displayName: 重要性
  formula.schedule:
    displayName: 預計執行日期
  formula.due:
    displayName: 截止日期（死線）
  note.Task：Done:
    displayName: 完成日期
  note.Task：Cancelled:
    displayName: 取消日期
  note.Task：Archived:
    displayName: 歸檔日期
  formula.finish-state:
    displayName: 任務完成狀態
views:
  - type: table
    name: View
    order:
      - Task：Content
      - Task：Status
      - Task：Priority
      - formula.schedule
      - formula.due
      - formula.finish-state
    cardSize: 210
    columnSize:
      note.Task：Status: 124
