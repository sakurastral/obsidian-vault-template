filters:
  and:
    - file.path == this.file.path
    - file.folder == this.file.folder
formulas:
  schedule: if(note["Task：Scheduled(Start)"] && note["Task：Scheduled(Start)"]!="",note["Task：Scheduled(Start)"].format("YYYY-MM-DD HH:mm"),"")+if(note["Task：Scheduled(End)"] && (note["Task：Scheduled(Start)"].toString() != note["Task：Scheduled(End)"].toString()), " ~ "+note["Task：Scheduled(End)"].format("YYYY-MM-DD HH:mm"), "")
  due: Task：Due.format("YYYY-MM-DD HH:mm")
  finish-state: |-
    if(Task：Done, "Completed on "+Task：Done.format("YYYY/MM/DD")+"", "")+
    if(Task：Cancelled, "Cancelled on "+Task：Cancelled.format("YYYY/MM/DD")+"","")+if(Task：Archived, " and is Archived", "")
properties:
  note.Task：Content:
    displayName: Content
  note.Task：Status:
    displayName: Progress
  note.Task：Priority:
    displayName: Importance
  formula.schedule:
    displayName: Scheduled
  formula.due:
    displayName: Deadline
  note.Task：Done:
    displayName: Completed
  note.Task：Cancelled:
    displayName: Cancelled
  note.Task：Archived:
    displayName: Archived
  formula.finish-state:
    displayName: Status(Completion)
views:
  - type: dynamic-views-grid
    name: View
    order:
      - Task：Content
      - Task：Status
      - Task：Priority
      - formula.schedule
      - formula.due
      - formula.finish-state
    cardSize: 400
    id: 05b109-View
    fallbackToContent: false
    imageProperty: note.cover
    imageFormat: backdrop
    pairProperties: false
