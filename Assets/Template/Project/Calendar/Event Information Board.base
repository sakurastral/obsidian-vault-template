filters:
  and:
    - file.name == this.file.name
properties:
  note.calendar-event-type:
    displayName: Type
  note.calendar-event-end:
    displayName: End Date
  note.calendar-event-start:
    displayName: Start Date
  note.calendar-event-title:
    displayName: Title
views:
  - type: table
    name: Basic
    order:
      - calendar-event-type
      - calendar-event-start
      - calendar-event-end
    sort:
      - property: calendar-event-start
        direction: ASC
    columnSize:
      note.calendar-event-type: 107
      note.calendar-event-start: 152
  - type: table
    name: Title
    order:
      - calendar-event-title
